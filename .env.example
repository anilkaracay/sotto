# Names only. Values live in secret stores, never in the repo.

# web
NEXT_PUBLIC_CLUSTER=
NEXT_PUBLIC_APP_URL=
RPC_URL=
DATABASE_URL=
SESSION_SECRET=
SCREENING_PROVIDER=
SCREENING_API_KEY=
ADMIN_WALLETS=
RESEND_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# worker (RPC_URL, DATABASE_URL and SENTRY_DSN as above)
SAS_SIGNER_KEYPAIR=
SAS_SIGNER_KMS_KEY_ID=
SAS_CREDENTIAL_ADDRESS=
SAS_SCHEMA_ADDRESS=
# Worker, optional (step 4.2): a Discord webhook or Telegram bot sendMessage URL with chat_id; the
# review notification is skipped without it. It holds a token: never commit a value.
SOTTO_NOTIFY_URL=

# A local validator only (NEXT_PUBLIC_CLUSTER=localnet): the addresses that
# scripts/bootstrap-localnet.ts writes to .localnet/bootstrap.json.
# web and worker
LOCALNET_USDC_MINT=
LOCALNET_DEVUSD_MINT=
# web
LOCALNET_SAS_CREDENTIAL=
LOCALNET_SAS_SCHEMA=
LOCALNET_SOTTO_PROOFS_PROGRAM=
LOCALNET_DEVUSD_SOTTO_PROOFS_PROGRAM=
# worker: the path of the devUSD mint authority's keypair file, for the faucet
DEVUSD_MINT_AUTHORITY_KEYPAIR=
# worker: the path of the SOL faucet's own keypair file (step 4.6, D-31); another key than the one above
SOL_FAUCET_KEYPAIR=
# web, optional (step 4.6, D-32): the path of the demo company's file, written by
# scripts/demo-company-file.ts. It holds published demo viewing keys, no wallet key.
DEMO_COMPANY_FILE=
