# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
dist/
build/
.turbo/
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# Environment files (.env.example stays tracked)
.env
.env.*
.env*.local
.envrc
# Any env file under any name or folder, and the hosting credentials (step 4.1): they live only in
# ~/.config/sotto/hosting.env, outside the repository.
**/.env
**/.env.*
*.env
**/*.env
hosting.env
**/hosting.env
# Kept tracked: the template, last so it wins over the patterns above.
!.env.example

# Keypairs: never commit wallet or program secrets
*keypair*.json
wallet-*.json
id.json
*-deployer.json
*.keypair

# Rust and Anchor
target/
.anchor/
test-ledger/

# Fetched and built artifacts (Token Wrap .so) and the local validator ledger
.cache/
.localnet/

# Next.js generated types (recreated by next typegen)
next-env.d.ts

# Local files, never committed.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Step 2.10: the acceptance spec copies its screenshots here after a pass (for the demo plan).
.demo-shots/
