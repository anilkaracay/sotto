{
  "name": "sotto",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "program:build": "cargo-build-sbf --manifest-path programs/sotto_proofs/Cargo.toml --arch v3 -- --locked",
    "program:test": "cargo test --locked -p sotto_proofs",
    "ci:local": "scripts/ci-local.sh",
    "ci:local:full": "scripts/ci-local.sh --full"
  },
  "prettier": "@sotto/config/prettier",
  "devDependencies": {
    "@sotto/config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
